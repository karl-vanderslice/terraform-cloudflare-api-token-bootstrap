# Copy this file to terraform.tfvars and set the account ID from the Cloudflare dashboard.
cloudflare_account_id = "0123456789abcdef0123456789abcdef"

# Optional. The default grants read permissions only.
# token_mode = "read_only"
# token_name = "cloudflare-mcp-read-only"
# allowed_cidrs = ["203.0.113.10/32"]

# To retain the original broad administrative behavior, set:
# token_mode = "admin"
